    <labels>
        <fullName>NewSalesPE_Promo_Config_Warning_Query</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>NewSalesPE Promo Config Warning Query</shortDescription>
        <value>SELECT Id,vlocity_cmt__PromotionId__r.vlocity_cmt__Code__c
                FROM vlocity_cmt__CatalogProductRelationship__c WHERE vlocity_cmt__PromotionId__r.Segment__c =&apos;Residenziale&apos; AND 
                (vlocity_cmt__PromotionId__r.Canale__c like &apos;%NEW SALES%&apos; OR vlocity_cmt__PromotionId__r.Canale__c like &apos;%NEWSALES%&apos; ) AND 
                vlocity_cmt__PromotionId__r.PromoSkyClass__c = &apos;Promo Sales&apos; AND 
                vlocity_cmt__PromotionId__r.vlocity_cmt__IsActive__c =true and (vlocity_cmt__PromotionId__r.vlocity_cmt__EffectiveEndDate__c &gt; today OR  vlocity_cmt__PromotionId__r.vlocity_cmt__EffectiveEndDate__c=null ) AND
                vlocity_cmt__PromotionId__r.vlocity_cmt__PriceListId__r.vlocity_cmt__Code__c = &apos;Listino_Sky_NPP&apos; AND 
                vlocity_cmt__CatalogId__r.vlocity_cmt__CatalogCode__c IN:catalogCodes</value>
    </labels>
